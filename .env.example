# PostgreSQL 16 + pgvector connection string
DATABASE_URL="dbname=bankrag user=linux1 host=localhost port=5432"

# Jina Embeddings v3 API Key (768-dim multilingual embeddings)
JINA_API_KEY="your_jina_api_key_here"

# Groq API Key for LLM Guardrail & RAG Generation
GROQ_API_KEY="your_groq_api_key_here"

# Optional model overrides
RAG_MODEL="openai/gpt-oss-120b"
GUARD_MODEL="openai/gpt-oss-120b"

# Set when the website runs on another machine (e.g. Vercel): the same value goes in the website's settings.
# With it set, /api/* answers only the website. Generate one with: openssl rand -hex 24
# PROXY_SHARED_SECRET=
