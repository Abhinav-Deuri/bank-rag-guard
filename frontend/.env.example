# Server-only. Read by the Next.js route handlers in app/api/*, never sent to the browser.
# Do not prefix with NEXT_PUBLIC_. Do not put database URLs or Jina / Groq keys here:
# those belong only in the Python backend's own .env.
#
# Local: FastAPI running on the same machine as `next dev`.
# Deployed: a URL your frontend's *server* can reach (not 127.0.0.1 on your laptop).
BACKEND_URL=http://127.0.0.1:8000

# Optional. Only needed when the backend runs on a different machine: set the same random value here and in the
# backend's .env so the backend trusts the visitor address this proxy forwards (per-visitor rate limits).
# PROXY_SHARED_SECRET=
